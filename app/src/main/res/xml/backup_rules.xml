<?xml version="1.0" encoding="utf-8"?>
<!-- Android 11 and lower. allowBackup="false" already stops backup there; this keeps the same
     result if that attribute ever changes. Consent receipts, the encrypted device credential,
     and saved routes must never leave the device. -->
<full-backup-content>
    <exclude domain="root" path="." />
    <exclude domain="file" path="." />
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="external" path="." />
</full-backup-content>
