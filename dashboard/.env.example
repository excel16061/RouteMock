# Placeholders only. Never put a real value in this file.
#
# Local use needs no setup: the dashboard creates dashboard/.env with a random secret on first
# run, readable only by you. dashboard/.env is ignored by Git.
#
# The dashboard refuses to start with this placeholder.
ROUTEMOCK_SECRET_KEY=replace-with-a-long-random-value

# Only this value is read from dashboard/.env. These are read from the environment instead:
#   ROUTEMOCK_DEBUG=1                  Set 0 outside local use. See docs/DEPLOYMENT.md first.
#   ROUTEMOCK_ALLOWED_HOSTS=           Comma-separated host names. Used when ROUTEMOCK_DEBUG=0.
#   ROUTEMOCK_DB=                      Path of the SQLite database.
#   ROUTEMOCK_EVIDENCE_DIR=            Folder for uploaded evidence, outside any web root.
